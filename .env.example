# Pallot settings. Copy this file to .env (git ignores it) and fill in what you need;
# Pallot reads .env from its folder at startup. Variables already set in the environment win.

# A free FEC key, for where each congressional candidate's money comes from:
# https://api.open.fec.gov/developers/ (api.data.gov emails it to you). Without one, Pallot
# uses the shared DEMO_KEY, which allows race totals only and runs out after a few requests.
PALLOT_FEC_API_KEY=
# Optional: up to four more keys. Pallot uses them all in turn (the FEC allows each 60 calls a minute).
# PALLOT_FEC_API_KEY2=
# PALLOT_FEC_API_KEY3=
# PALLOT_FEC_API_KEY4=
# PALLOT_FEC_API_KEY5=

# A Google Geocoding API key, for addresses neither the Census nor OpenStreetMap can find (new streets):
# https://developers.google.com/maps/documentation/geocoding/get-api-key (enable the Geocoding API).
# Asked last, and only for an address both of them missed. Without one, Google isn't used.
PALLOT_GOOGLE_API_KEY=

# Where the cache, SBOE and precinct maps, TrackAIPAC/Vote for Peace/TEC data and an optional sources.toml
# (which sources start on, for everyone) live (default: data/ here).
# PALLOT_DATA_DIR=/var/lib/pallot

# Nominatim and OpenStreetMap's tile server ask for a User-Agent that names the app and a way to
# reach whoever runs it; adding your email is polite.
# PALLOT_USER_AGENT=Pallot/0.1 (personal ballot helper; +https://github.com/Just-Peace/Pallot; you@example.com)

# Seconds to wait for a source before giving up.
# PALLOT_HTTP_TIMEOUT=30

# Names you open Pallot by, besides localhost and IP addresses, comma-separated: a name on
# your network, or a reverse proxy's domain ("*" for any). Other names get an error.
# PALLOT_ALLOWED_HOSTS=nas.local,pallot.example.com

# Cache lifetimes in seconds (all of them: pallot/config.py, class Ttls). For example:
# PALLOT_TTL_GEOCODE_BACKOFF=3600   # after the Census geocoder, Nominatim or Google refuses a request, stop asking that one for this long
# PALLOT_TTL_SOS_BACKOFF=3600       # after Texas SOS refuses a request, stop asking for this long
# PALLOT_TTL_SOS_ELECTIONS_BUNDLE=259200     # Texas SOS's elections that come with Pallot, from when they were last checked: 3 days
# PALLOT_TTL_SOS_REFERENCE_BUNDLE=2592000    # its counties, parties and statuses that come with Pallot: 30 days
# PALLOT_TTL_SOS_CANDIDATES_BUNDLE=172800    # its statewide candidate lists that come with Pallot: 2 days
# PALLOT_TTL_SOS_BALLOT_ORDER_BUNDLE=172800  # its counties' ballot orders that come with Pallot: 2 days
# PALLOT_TTL_BALLOTPEDIA=86400      # Ballotpedia ballots: 1 day
# PALLOT_TTL_FEC=604800             # FEC answers: 7 days
# PALLOT_TTL_FEC_BACKOFF=120        # after the FEC rate limits a key, stop using that key for this long
# PALLOT_TTL_FEC_REFUSED_BACKOFF=3600  # after the FEC refuses a key, stop using that key for this long
# PALLOT_TTL_FEC_BUNDLE=604800      # the FEC's answers that come with Pallot, from when they were last checked: 7 days
# PALLOT_TTL_POLLS=86400            # FiftyPlusOne poll lists: 1 day
# PALLOT_TTL_POLLS_BACKOFF=3600     # after FiftyPlusOne refuses a request, stop asking for this long
# PALLOT_TTL_POLLS_BUNDLE=172800    # FiftyPlusOne's poll lists that come with Pallot, from when they were last checked: 2 days
# PALLOT_TTL_KEY_DATES=86400        # the Texas SOS's Important Election Dates page: 1 day
# PALLOT_TTL_KEY_DATES_BACKOFF=3600 # after that page is refused us, stop asking for this long
# PALLOT_TTL_OUTLINES=2592000       # the district map's outlines from the Census's TIGERweb: 30 days
# PALLOT_TTL_OUTLINES_BACKOFF=3600  # after TIGERweb refuses a request, stop asking for this long
# PALLOT_TTL_TIGERWEB_BUNDLE=3196800 # the outlines that come with Pallot, from when they were last checked: 37 days
# PALLOT_TTL_ELECTION_PRECINCTS=604800        # the Texas Legislative Council's list of precinct maps: 7 days
# PALLOT_TTL_ELECTION_PRECINCTS_BACKOFF=3600  # after its portal refuses a request, stop asking for this long
# PALLOT_TTL_COUNTY_PRECINCTS=604800          # counties' lists of their election precincts, and maps of commissioner and JP precincts: 7 days
# PALLOT_TTL_COUNTY_PRECINCTS_BACKOFF=3600    # after a county's map server refuses a request, stop asking the counties for this long
# PALLOT_TTL_COUNTY_PRECINCTS_BUNDLE=1209600  # the seven counties' lists and maps that come with Pallot, from when they were last checked: 14 days
# PALLOT_TTL_ENDORSEMENT_FEEDS=604800         # organizations' endorsement lists fetched from their websites: 7 days
# PALLOT_TTL_ENDORSEMENT_FEEDS_BACKOFF=3600   # after an organization's website refuses a request, stop asking it for this long
# PALLOT_TTL_OFFICEHOLDERS=604800             # the lists of who holds each congressional and legislative seat: 7 days
# PALLOT_TTL_OFFICEHOLDERS_BACKOFF=3600       # after either list is refused, stop asking for this long
# PALLOT_TTL_OFFICEHOLDERS_BUNDLE=1209600     # both lists that come with Pallot, from when they were last checked: 14 days
# PALLOT_TTL_TILES=604800           # street map tiles from OpenStreetMap: 7 days, the least its tile policy allows (less is raised to 7 days)
# PALLOT_TTL_TILES_BACKOFF=3600     # after OpenStreetMap's tile server refuses a request, stop asking for this long
# PALLOT_TTL_SUGGEST=2592000        # address suggestions: 30 days
# PALLOT_TTL_RETRY_AFTER=900        # after a source fails, serve the old copy this long before asking again
# PALLOT_TTL_PRUNE_AFTER=2592000    # delete address suggestions, map tiles and addresses not found expired this long (at startup, every 6 hours, and pallot-cache prune)

# The most the street map's tiles and the address suggestions keep in the cache, in MB; past it, the oldest go.
# PALLOT_TILES_MAX_MB=512
# PALLOT_SUGGEST_MAX_MB=64

# How often a running server prunes those caches, in seconds: 6 hours.
# PALLOT_PRUNE_EVERY=21600

# The port: `uv run pallot`'s (or --port), and the host port in Docker Compose (compose.yaml).
# PALLOT_PORT=8000

# Docker Compose only: the user and group that own data/.
# PALLOT_UID=1000
# PALLOT_GID=1000
