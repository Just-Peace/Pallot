# VoteBot settings. Copy this file to .env (git ignores it) and fill in what you need;
# VoteBot reads .env from its folder at startup. Variables already set in the environment win.

# A free FEC key, for where each congressional candidate's money comes from:
# https://api.open.fec.gov/developers/ (api.data.gov emails it to you). Without one, VoteBot
# uses the shared DEMO_KEY, which allows race totals only and runs out after a few requests.
VOTEBOT_FEC_API_KEY=

# Where the cache, settings, SBOE and precinct maps and TrackAIPAC/TEC data live (default: data/ here).
# VOTEBOT_DATA_DIR=/var/lib/votebot

# Nominatim and OpenStreetMap's tile server ask for a User-Agent that names the app and a way to
# reach whoever runs it; adding your email is polite.
# VOTEBOT_USER_AGENT=VoteBot/0.1 (personal ballot helper; +https://github.com/Fahd-Siddiqui/VoteBot; you@example.com)

# Seconds to wait for a source before giving up.
# VOTEBOT_HTTP_TIMEOUT=30

# Names you open VoteBot by, besides localhost and IP addresses, comma-separated: a name on
# your network, or a reverse proxy's domain ("*" for any). Other names get an error.
# VOTEBOT_ALLOWED_HOSTS=nas.local,votebot.example.com

# Cache lifetimes in seconds (all of them: votebot/config.py, class Ttls). For example:
# VOTEBOT_TTL_BALLOTPEDIA=86400      # Ballotpedia ballots: 1 day
# VOTEBOT_TTL_FEC=604800             # FEC answers: 7 days
# VOTEBOT_TTL_POLLS=86400            # FiftyPlusOne poll lists: 1 day
# VOTEBOT_TTL_POLLS_BACKOFF=3600     # after FiftyPlusOne refuses a request, stop asking for this long
# VOTEBOT_TTL_KEY_DATES=86400        # the Texas SOS's Important Election Dates page: 1 day
# VOTEBOT_TTL_KEY_DATES_BACKOFF=3600 # after that page is refused us, stop asking for this long
# VOTEBOT_TTL_OUTLINES=2592000       # the district map's outlines from the Census's TIGERweb: 30 days
# VOTEBOT_TTL_OUTLINES_BACKOFF=3600  # after TIGERweb refuses a request, stop asking for this long
# VOTEBOT_TTL_ELECTION_PRECINCTS=604800        # the Texas Legislative Council's list of precinct maps: 7 days
# VOTEBOT_TTL_ELECTION_PRECINCTS_BACKOFF=3600  # after its portal refuses a request, stop asking for this long
# VOTEBOT_TTL_TILES=604800           # street map tiles from OpenStreetMap: 7 days, the least its tile policy allows
# VOTEBOT_TTL_TILES_BACKOFF=3600     # after OpenStreetMap's tile server refuses a request, stop asking for this long
# VOTEBOT_TTL_SUGGEST=2592000        # address suggestions: 30 days
# VOTEBOT_TTL_RETRY_AFTER=900        # after a source fails, serve the old copy this long before asking again
# VOTEBOT_TTL_PRUNE_AFTER=2592000    # at startup, delete address suggestions, map tiles and addresses not found expired this long

# Docker Compose only (compose.yaml): the host port, and the user and group that own data/.
# VOTEBOT_PORT=8000
# VOTEBOT_UID=1000
# VOTEBOT_GID=1000
