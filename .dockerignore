# all of .git but what names the commit, which the build writes into the image for the footer
.git/*
!.git/HEAD
!.git/refs
!.git/packed-refs
.venv
# the FEC key: compose.yaml passes .env in at run time, never into the image
.env
# only the top-level data folder: tec_cache/data, trackaipac_cache/data, voteforpeace_cache/data and bundles/data are bundled with Pallot
/data
tests
scripts
**/__pycache__
*.pyc
.pytest_cache
*.egg-info
build
